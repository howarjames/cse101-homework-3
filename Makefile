#  your changes will fail to build on Gradescope and score 0.
#
#  If you changed this file by accident, restore the original with:
#      git checkout -- Makefile
#
#  Usage:
#    make         check the rules, then build ./sixdegrees
#    make test    build, then run every test in tests/
#    make clean   remove the program and test output
# =============================================================================

CXX      := g++
override CXXFLAGS := -std=c++17 -O2 -Wall -Wextra -pedantic-errors
TARGET   := sixdegrees

.PHONY: all check test clean

all: check $(TARGET)

check:
	@bash scripts/check_rules.sh source

$(TARGET): main.o graph.o queue.o
	@bash scripts/check_rules.sh symbols main.o graph.o queue.o
	$(CXX) $(CXXFLAGS) -o $(TARGET) main.o graph.o queue.o

main.o: main.cpp graph.h check
	$(CXX) $(CXXFLAGS) -c main.cpp

graph.o: graph.cpp graph.h queue.h check
	$(CXX) $(CXXFLAGS) -c graph.cpp

queue.o: queue.cpp queue.h check
	$(CXX) $(CXXFLAGS) -c queue.cpp

test: all
	@bash run_tests.sh

clean:
	rm -f $(TARGET) $(TARGET).exe *.o
	rm -rf test_output
